[Unit]
Description=SH Platform Scraper Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sh-platform
ExecStart=/usr/bin/java -Xmx768m -Xms256m -jar /home/ubuntu/sh-platform/builds/sh-platform-scraper.jar --server.port=8081
Restart=on-failure
RestartSec=10
EnvironmentFile=/home/ubuntu/sh-platform/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
