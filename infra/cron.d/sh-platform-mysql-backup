# sh-platform 백업 스케줄 (cron.d, CI 배포 시 복사 — 멱등)
# a) MySQL 주기 전체 백업 (스크립트: scripts/backup-mysql.sh, 로그: backup-YYYYMMDD.log)
# b) 웹/WAS 파일 데이터 백업 (스크립트: scripts/backup-files.sh, 로그: backup-YYYYMMDD.log)
# - 상세: docs/guides/009-260914-mysql-backup-guide.md
CRON_TZ=Asia/Seoul
30 3 * * * root /home/ubuntu/sh-platform/scripts/backup-mysql.sh >> /home/ubuntu/backups/mysql/backup-$(date +\%Y\%m\%d).log 2>&1
35 3 * * * root /home/ubuntu/sh-platform/scripts/backup-files.sh >> /home/ubuntu/backups/files/backup-$(date +\%Y\%m\%d).log 2>&1